              or ( (91 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) =  9 + year-from-date(@notBefore)) )
              or ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (26 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (51 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (76 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 49 + year-from-date(@notBefore)) )
