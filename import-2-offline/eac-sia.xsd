      <xs:anyAttribute namespace="##other" processContents="lax"/>

      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac &#xa; @standardDate|@notBefore|@notAfter formato atteso AAAA-MM-GG o AAAA-MM o AAAA"
         test="
            every $v in (@standardDate|@notBefore|@notAfter)
            satisfies matches(string($v),'^[0-9]{4}(-[0-9]{2}(-[0-9]{2})??)??$')
         "/>
      
      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac &#xa; valore non atteso in date/@localType"
         test="
            every $v in @localType
            satisfies (
                $v='EstremoCronologicoTestuale'
             or $v='DataSingola'
             or $v='PeriodoDiChiusura'
             or $v='NoteAllaDatazione'
             or $v='Secolo'
            )
         "/>

      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac &#xa; date[@localType='EstremoCronologicoTestuale'] richiede contenuto"
         test="
            not(@localType='EstremoCronologicoTestuale')
             or 
            (string-length(normalize-space(.)) &gt; 0)
         "/>
         
      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac &#xa; fromDate[@localType='Secolo'] richiede @notBefore e @notAfter"
         test="
            if(@localType='Secolo')
            then
            (@notBefore and @notAfter)
            else true()
         "/>
         
      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac &#xa; la codifica del secolo ammette solo valori controllati e (con mese e giorno estremi 01-01, 12-31)&#xa;
 ----------+-----------+--------------&#xa;
 notBefore | notAafter |&#xa;
 ----------+-----------+--------------&#xa;
   nn01    |     nn10  | Inizio&#xa;
   nn41    |     nn60  | Metà&#xa;
   nn91    | (nn+1)00  | Fine&#xa;
   nn01    |     nn25  | Primo quarto&#xa;
   nn26    |     nn50  | Secondo quarto&#xa;
   nn51    |     nn75  | Terzo quarto&#xa;
   nn76    | (nn+1)00  | Ultimo quarto&#xa;
   nn01    |     nn50  | Prima metà&#xa;
   nn51    | (nn+1)00  | Seconda metà&#xa;
   nn01    | (nn+1)00  | Completo&#xa;
 ----------+-----------+--------------&#xa;
"
         test="
            if ((not(@localType) or (@localType='Secolo')) and @notBefore and @notAfter)
            then
            (
             (string-length(string(@notBefore)) &lt; 6 or month-from-date(@notBefore)=1)
              and
             (string-length(string(@notBefore)) &lt; 9 or day-from-date(@notBefore)=1)
              and
             (string-length(string(@notAfter )) &lt; 6 or month-from-date(@notAfter)=12)
              and
             (string-length(string(@notAfter )) &lt; 9 or day-from-date(@notAfter)=31)
              and
             (
                 ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) =  9 + year-from-date(@notBefore)) )
              or ( (41 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 19 + year-from-date(@notBefore)) )
              or ( (91 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) =  9 + year-from-date(@notBefore)) )
              or ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (26 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (51 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( (76 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 24 + year-from-date(@notBefore)) )
              or ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 49 + year-from-date(@notBefore)) )
              or ( (51 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 49 + year-from-date(@notBefore)) )
              or ( ( 1 = (year-from-date(@notBefore) mod 100)) and (year-from-date(@notAfter) = 99 + year-from-date(@notBefore)) )
             )
            )
            else true()
         "/>
      <!-- 
       eac 0030 0036 0050 0056 0073 0079 0097 0103 0115 0121 0136 0142 0164 0170 0188 0194 0206 0212 0227 0233 0247 0253 0276 0282 0300 0306 0326 0332 0348 0354 0368 0374 0388 0394 0408 0414 0437 0443 0460 0466 0483 0489 0515 0521 0542 0548 0562 0568 0581 0587 0653 0659 0675 0681 0744 0750 0768 0774 0789 0795 0811 0817 0833 0839 0894 0900 0918 0924 0940 0946 0961 0967 0981 0987 1039 1046
       date/@certainty 'Validità' Lista chiusa: dataApprossimativa, dataAttribuita, dataIncerta, dataIncertaAttribuita, dataPostQuem.
      -->
      <xs:assert xpathDefaultNamespace="https://archivists.org/ns/eac/v2"
         xao:message="=&gt;&#xa;eac 0030 0036 0050 0056 0073 0079 0097 0103 0115 0121 0136 0142 0164 0170 0188 0194 0206 0212 0227 0233 0247 0253 0276 0282 0300 0306 0326 0332 0348 0354 0368 0374 0388 0394 0408 0414 0437 0443 0460 0466 0483 0489 0515 0521 0542 0548 0562 0568 0581 0587 0653 0659 0675 0681 0744 0750 0768 0774 0789 0795 0811 0817 0833 0839 0894 0900 0918 0924 0940 0946 0961 0967 0981 0987 1039 1046&#xa;
date/@certainty&#xa; 'Validità' lista chiusa con valori:&#xa;
DataApprossimativa,
DataAttribuita,
DataIncerta,
DataIncertaAttribuita,
DataPostQuem,
DataAnteQuem."
         test="
            every $v in (@certainty)
            satisfies
            (
                $v='DataApprossimativa'
             or $v='DataAttribuita'
             or $v='DataIncerta'
             or $v='DataIncertaAttribuita'
             or $v='DataPostQuem'
             or $v='DataAnteQuem'
            )
           "/>
      
      <!-- 0026 0046 0069 0093 0111 0132 0160 0184 0202 0223 0243 0272 0296 0322 0344 0364 0384 0404 0433 0456 0479 0511 0538 0558 0577 0649 0671 0740 0764 0785 0807 0829 0890 0914 0936 0957 0977 1034
